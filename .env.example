# Copy to .env and fill in. Values marked REQUIRED have no default: `docker compose up` refuses to start without them.
# Quoting: wrap JSON in single quotes; write a literal "$" as "$$".

# ---- PostgreSQL (bundled container) ----
POSTGRES_DB=goo
POSTGRES_USER=goo
# REQUIRED. URL-safe characters only (it is embedded in DATABASE_URL), e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Server secrets ----
# REQUIRED. >= 32 chars, never reuse the example. Generate with: openssl rand -hex 32
# Changing it invalidates all sessions and tokens (everyone signs in again, desktop apps included).
GOO_SIGNING_SECRET=
# REQUIRED. Strictly validated JSON array; at most one super_admin; passwords >= 12 chars (no defaults like "admin").
# Accounts are created at boot if missing; existing accounts are never modified. roles: super_admin | platform_admin
GOO_ADMIN_BOOTSTRAP='[{"email":"admin@example.com","password":"CHANGE-ME-to-a-long-passphrase","display_name":"Admin","platform_role":"super_admin"}]'

# ---- Public URL / HTTPS ----
# Public base URL as seen by browsers and the goo app (used to build the desktop sign-in link <base>/device).
GOO_BASE_URL=http://localhost
# HTTP mode (default): keep deploy/Caddyfile and GOO_COOKIE_SECURE=false (Secure cookies are never sent over http://).
# HTTPS mode: uncomment the four lines below, set the domain, and make GOO_BASE_URL https://<domain>.
#GOO_CADDYFILE=./deploy/Caddyfile.https
#GOO_DOMAIN=cloud.example.com
#GOO_BASE_URL=https://cloud.example.com
#GOO_COOKIE_SECURE=true
GOO_COOKIE_SECURE=false
GOO_HTTP_PORT=80
GOO_HTTPS_PORT=443

# ---- Optional ----
# Extra browser origins allowed to call the API with credentials (comma-separated bare origins). Not needed for the
# bundled dashboard, which the server serves from its own origin. Never "*".
GOO_ALLOWED_ORIGINS=
# memory (per process) or postgres (shared by every server instance; use it when you run more than one).
GOO_RATE_LIMIT_STORE=memory
# Image to run. Compose builds it from server/Dockerfile (dashboard included) under this name; to run a published image
# instead, set e.g. ghcr.io/perunok/goo-cloud:0.1.0 and start with `docker compose up -d --no-build`.
GOO_IMAGE=goo-cloud:latest
